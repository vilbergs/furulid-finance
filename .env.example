# Copy to .env (gitignored). jevcat loads it on start; exported variables take precedence.
ACTUAL_HTTP_API_KEY=          # the API_KEY set as a Fly secret on the actual-http-api app
TYPESAFE_API_KEY=             # from your TypeSafe account
# ACTUAL_ENCRYPTION_PASSWORD= # only if the budget is end-to-end encrypted

# Fly app names, only used by the deploy commands in deploy/actual-api/README.md
ACTUAL_SERVER_APP=            # the app running the Actual server
ACTUAL_API_APP=               # the app running actual-http-api
